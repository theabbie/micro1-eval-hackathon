  "queries": [
    {"id": "q1", "query": "Observation?date=2024-02",
     "expected": ["Observation/g-01", "Observation/g-05", "Observation/g-10", "Observation/g-12", "Observation/g-13"],
     "rationale": "Contained in [02-01T05:00Z, 03-01T05:00Z). 01 = 02-29T10:30Z; 05 = 04:30Z Mar 1 = 23:30 EST Feb 29; 12 = 04:59:59Z (its 1-second range ends exactly at 05:00Z); 13 = 04:30Z. 02 (-12:00) = 03-01T11:30Z is March; 11 = 05:00Z is March."},
    {"id": "q2", "query": "Observation?date=2024-03",
     "expected": ["Observation/g-02", "Observation/g-03", "Observation/g-06", "Observation/g-07", "Observation/g-08", "Observation/g-11", "Observation/g-14"],
     "rationale": "Contained in [03-01T05:00Z, 04-01T04:00Z). 03 = 04-01T03:30Z (in); 14 = 04-01T00:30Z (in); 04 = 04-01T04:30Z = 00:30 EDT Apr 1 (out). 06 = 01:59 EST = 06:59Z; 07 = 03:00 EDT = 07:00Z; 08 is the 23-hour day. Open-ended 16 and spanning 09 are not contained."},
    {"id": "q3", "query": "Observation?date=ge2024-03-01&date=le2024-03-31",
     "expected": ["Observation/g-02", "Observation/g-03", "Observation/g-06", "Observation/g-07", "Observation/g-08", "Observation/g-09", "Observation/g-11", "Observation/g-14", "Observation/g-15", "Observation/g-16"],
     "rationale": "Overlaps March local. Feb-only values end by 05:00Z Mar 1 (12 ends exactly there: no overlap); 04 (04:30Z Apr 1) is after March ends at 04:00Z. Year 15, spanning 09 and open-ended 16 overlap."},
    {"id": "q4", "query": "Observation?date=eb2024-03-01",
     "expected": ["Observation/g-01", "Observation/g-05", "Observation/g-10", "Observation/g-12", "Observation/g-13"],
     "rationale": "Ends at or before 03-01T05:00Z (start of Mar 1 EST). 12's range [04:59:59Z, 05:00:00Z) ends exactly there."},
    {"id": "q5", "query": "Observation?date=sa2024-03-31",
     "expected": ["Observation/g-04"],
     "rationale": "Starts at or after 04-01T04:00Z (end of Mar 31 EDT)."},
    {"id": "q6", "query": "Observation?date=ne2024-03",
     "expected": ["Observation/g-01", "Observation/g-04", "Observation/g-05", "Observation/g-09", "Observation/g-10", "Observation/g-12", "Observation/g-13", "Observation/g-15", "Observation/g-16"],
     "rationale": "Complement of q2 among the 16 (all have a value)."},
    {"id": "q7", "query": "Observation?date=gt2024-03-31T23:59-04:00",
     "expected": ["Observation/g-04", "Observation/g-15", "Observation/g-16"],
     "rationale": "Search value is the minute [04-01T03:59Z, 04-01T04:00Z); gt needs T to extend past 04:00Z. 03 (03:30Z) and 14 (00:30Z) do not."}
