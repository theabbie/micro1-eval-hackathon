  "queries": [
    {
      "id": "q1",
      "query": "MedicationStatement?effective=ge2024-06-15&effective=le2024-06-15",
      "expected": [
        "MedicationStatement/m-01",
        "MedicationStatement/m-02",
        "MedicationStatement/m-04",
        "MedicationStatement/m-05",
        "MedicationStatement/m-06",
        "MedicationStatement/m-09",
        "MedicationStatement/m-10"
      ],
      "rationale": "Overlaps the local day [06-15T04:00Z, 06-16T04:00Z). 03 ends at 06-15T04:00Z (no overlap); 04 ends at 06-16T04:00Z (overlaps); 06 is 22:00 EDT Jun 15 (in); 07 is 22:00 EDT Jun 14 (out); 12 starts exactly at 06-16T04:00Z (out); 11 has no value."
    },
    {
      "id": "q2",
      "query": "MedicationStatement?effective=2024-06-15",
      "expected": [
        "MedicationStatement/m-02",
        "MedicationStatement/m-06",
        "MedicationStatement/m-10"
      ],
      "rationale": "Fully contained in the local day."
    },
    {
      "id": "q3",
      "query": "MedicationStatement?effective=eb2024-06-15",
      "expected": [
        "MedicationStatement/m-03",
        "MedicationStatement/m-07"
      ],
      "rationale": "Ends at or before 06-15T04:00Z. 04 (end '2024-06-15') does not end before the day."
    },
    {
      "id": "q4",
      "query": "MedicationStatement?effective=sa2024-06-15",
      "expected": [
        "MedicationStatement/m-08",
        "MedicationStatement/m-12"
      ],
      "rationale": "Starts at or after 06-16T04:00Z. 12 starts 21:00 PDT = 00:00 EDT Jun 16."
    },
    {
      "id": "q5",
      "query": "MedicationStatement?effective=ge2024-06-15&effective=le2024-06-15&status=active",
      "expected": [
        "MedicationStatement/m-01",
        "MedicationStatement/m-05",
        "MedicationStatement/m-06"
      ],
      "rationale": "q1 restricted to status=active."
    },
    {
      "id": "q6",
      "query": "MedicationStatement?effective:missing=true",
      "expected": [
        "MedicationStatement/m-11"
      ],
      "rationale": "Only m-11 has no effective[x]."
    },
    {
      "id": "q7",
      "query": "MedicationStatement?effective=2024-06-15T08:00-04:00",
      "expected": [
        "MedicationStatement/m-10"
      ],
      "rationale": "eq with a minute-precision search value: the target must lie inside [12:00Z, 12:01Z). Only m-10 (08:00:00 EDT, one second) does; periods that cover 08:00 are not contained in the minute."
    },
    {
      "id": "q8",
      "query": "MedicationStatement?effective=ne2024-06-15T08:00-04:00",
      "expected": [
        "MedicationStatement/m-01",
        "MedicationStatement/m-02",
        "MedicationStatement/m-03",
        "MedicationStatement/m-04",
        "MedicationStatement/m-05",
        "MedicationStatement/m-06",
        "MedicationStatement/m-07",
        "MedicationStatement/m-08",
        "MedicationStatement/m-09",
        "MedicationStatement/m-12"
      ],
      "rationale": "Every indexed statement except m-10; m-11 has no value so never matches ne."
    }
  ],
