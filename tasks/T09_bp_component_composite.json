 "queries": [
  {
   "id": "q1",
   "query": "Observation?component-code=http://loinc.org|8462-4&component-value-quantity=ge90",
   "expected": [
    "Observation/bp-01",
    "Observation/bp-02",
    "Observation/bp-03",
    "Observation/bp-04",
    "Observation/bp-05",
    "Observation/bp-06",
    "Observation/bp-07",
    "Observation/bp-08",
    "Observation/bp-09"
   ],
   "rationale": "Independent parameters: any panel with a diastolic component code AND any component value >= 90 (every systolic qualifies). bp-06's diastolic component has a code but no value; its systolic 160 satisfies the value parameter. hr-01 and sbp-01 have no components."
  },
  {
   "id": "q2",
   "query": "Observation?component-code-value-quantity=http://loinc.org|8462-4$ge90",
   "expected": [
    "Observation/bp-02",
    "Observation/bp-04",
    "Observation/bp-07",
    "Observation/bp-08"
   ],
   "rationale": "Same component: diastolic >= 90. 89.6 is not >= 90 (exact comparison)."
  },
  {
   "id": "q3",
   "query": "Observation?component-code-value-quantity=http://loinc.org|8480-6$ge140,http://loinc.org|8462-4$ge90&status=final",
   "expected": [
    "Observation/bp-01",
    "Observation/bp-02",
    "Observation/bp-04",
    "Observation/bp-06",
    "Observation/bp-07"
   ],
   "rationale": "OR of the two composites, final only. The standalone systolic sbp-01 (152) has no components, so the component composite does not see it."
  },
  {
   "id": "q4",
   "query": "Observation?component-code-value-quantity=http://loinc.org|8480-6$ge140&component-code-value-quantity=http://loinc.org|8462-4$ge90",
   "expected": [
    "Observation/bp-04",
    "Observation/bp-07"
   ],
   "rationale": "AND of two composites: both systolic >= 140 and diastolic >= 90."
  },
  {
   "id": "q5",
   "query": "Observation?component-code-value-quantity=http://loinc.org|8480-6$140",
   "expected": [
    "Observation/bp-07",
    "Observation/bp-09"
   ],
   "rationale": "eq on '140' = [139.5, 140.5): 140 and 139.6."
  },
  {
   "id": "q6",
   "query": "Observation?code-value-quantity=http://loinc.org|8480-6$ge140",
   "expected": [
    "Observation/sbp-01"
   ],
   "rationale": "code-value-quantity joins Observation.code with Observation.value, so only the standalone systolic Observation can match; panel components are not searched."
  },
  {
   "id": "q7",
   "query": "Observation?value-quantity=gt90",
   "expected": [
    "Observation/hr-01",
    "Observation/sbp-01"
   ],
   "rationale": "value-quantity searches Observation.valueQuantity only: heart rate 98 and the standalone systolic 152. Panels have no valueQuantity."
  }
 ],
