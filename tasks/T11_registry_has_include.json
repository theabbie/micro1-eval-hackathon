 "queries": [
  {
   "id": "q1",
   "query": "Patient?_has:Observation:patient:code=http://loinc.org|4548-4&_has:Observation:patient:value-quantity=gt9",
   "expected": [
    "Patient/pt-1",
    "Patient/pt-2",
    "Patient/pt-3",
    "Patient/pt-5"
   ],
   "rationale": "Independent: pt-2 has an HbA1c (7.0) and a different Observation (glucose 250) with value > 9. pt-5's only HbA1c is entered-in-error but there is no status filter. pt-4 has no HbA1c."
  },
  {
   "id": "q2",
   "query": "Patient?_has:Observation:patient:code-value-quantity=http://loinc.org|4548-4$gt9",
   "expected": [
    "Patient/pt-1",
    "Patient/pt-3",
    "Patient/pt-5"
   ],
   "rationale": "Composite binds code and value on the same Observation."
  },
  {
   "id": "q3",
   "query": "Patient?_has:Observation:patient:code-value-quantity=http://loinc.org|4548-4$gt9&_has:Observation:patient:status=final",
   "expected": [
    "Patient/pt-1",
    "Patient/pt-3",
    "Patient/pt-5"
   ],
   "rationale": "Still independent: pt-5's HbA1c 10.1 is entered-in-error, but its LDL is final, so pt-5 matches."
  },
  {
   "id": "q4",
   "query": "Observation?code-value-quantity=http://loinc.org|4548-4$gt9&patient.gender=female",
   "expected": [
    "Observation/o-1",
    "Observation/o-5"
   ],
   "rationale": "o-1 (pt-1 female) and o-5 (pt-3 female). o-6 belongs to male pt-5; o-8's patient is not on the server, so the chain cannot be satisfied."
  },
  {
   "id": "q5",
   "query": "Observation?code-value-quantity=http://loinc.org|4548-4$gt9&_include=Observation:patient",
   "expected": {
    "match": [
     "Observation/o-1",
     "Observation/o-5",
     "Observation/o-6",
     "Observation/o-8"
    ],
    "include": [
     "Patient/pt-1",
     "Patient/pt-3",
     "Patient/pt-5"
    ]
   },
   "rationale": "o-8 matches but its patient (pt-9) is not on the server, so nothing is included for it. Included patients are not filtered."
  },
  {
   "id": "q6",
   "query": "Observation?patient=pt-2&_revinclude=Provenance:target",
   "expected": {
    "match": [
     "Observation/o-3",
     "Observation/o-4"
    ],
    "include": [
     "Provenance/prov-2"
    ]
   },
   "rationale": "prov-2 targets both matches and appears once; prov-1 targets o-1 (not a match)."
  },
  {
   "id": "q7",
   "query": "Patient?_has:Observation:patient:code=http://loinc.org|4548-4&gender=female&_revinclude=Provenance:target&_revinclude=Observation:patient",
   "expected": {
    "match": [
     "Patient/pt-1",
     "Patient/pt-3"
    ],
    "include": [
     "Provenance/prov-3",
     "Observation/o-1",
     "Observation/o-2",
     "Observation/o-5"
    ]
   },
   "rationale": "Matches: female patients with any HbA1c (pt-1, pt-3; pt-4 has only glucose). Revincludes: Provenance pointing at a matched Patient (prov-3), and every Observation of the matched patients, not only HbA1c (o-1, o-2, o-5). prov-1 points at an Observation, not a Patient match."
  }
 ],
