  "queries": [
    {
      "id": "q1",
      "query": "Observation?date=2024-11-03",
      "expected": [
        "Observation/k-01",
        "Observation/k-03",
        "Observation/k-05",
        "Observation/k-06",
        "Observation/k-07",
        "Observation/k-08",
        "Observation/k-09",
        "Observation/k-12",
        "Observation/k-13"
      ],
      "rationale": "Local day is [04:00Z Nov 3, 05:00Z Nov 4). 01 = 00:30 EDT (in); 02 = 23:30 EDT Nov 2 (out); 03 = 23:30 EST Nov 3 (in - fixed -04:00 would wrongly put it on Nov 4); 04 = 00:00 EST Nov 4 (out); 07 = 06:30Z (in); 09 offset-less 23:45 local EST (in); 10 month not contained; 11 starts on Nov 2."
    },
    {
      "id": "q2",
      "query": "Observation?date=ge2024-11-03T01:00-04:00&date=lt2024-11-03T01:00-05:00",
      "expected": [
        "Observation/k-05",
        "Observation/k-08",
        "Observation/k-10",
        "Observation/k-11",
        "Observation/k-12"
      ],
      "rationale": "The 'first' 01:00 hour: ge needs T to reach >= 05:00Z, lt needs T to start < 06:00Z. 12 (05:00:00Z) is in; 13 (06:00:00Z) fails lt; 06 (06:30Z) fails lt; 01 (04:30Z) fails ge. Wide targets (day 08, month 10, period 11) overlap both conditions."
    },
    {
      "id": "q3",
      "query": "Observation?date=sa2024-11-03",
      "expected": [
        "Observation/k-04"
      ],
      "rationale": "Starts at or after 05:00Z Nov 4. 03 (04:30Z) is still Nov 3 local."
    },
    {
      "id": "q4",
      "query": "Observation?date=eb2024-11-03",
      "expected": [
        "Observation/k-02"
      ],
      "rationale": "Ends at or before 04:00Z Nov 3. 11 ends at 11:00Z."
    },
    {
      "id": "q5",
      "query": "Observation?date=ne2024-11-03",
      "expected": [
        "Observation/k-02",
        "Observation/k-04",
        "Observation/k-10",
        "Observation/k-11"
      ],
      "rationale": "Not fully contained in the day: the two out-of-day instants, the month value, and the period that starts on Nov 2."
    },
    {
      "id": "q6",
      "query": "Observation?date=2024-11-03T01:30-05:00",
      "expected": [
        "Observation/k-06",
        "Observation/k-07"
      ],
      "rationale": "The minute [06:30Z, 06:31Z): k-06 (01:30 EST, the second 01:30) and k-07 (12:00+05:30 = 06:30Z). k-05 is the first 01:30 (05:30Z)."
    }
  ],
