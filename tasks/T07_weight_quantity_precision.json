{
  "id": "T07",
  "title": "Body-weight thresholds: quantity precision and units",
  "scenario": "A weight-based dosing check (e.g. a drug dosed differently at 100 kg) queries body-weight Observations. Weights arrive from scales, a device feed without a unit system, a pound-based import and a 'refused' entry. You are checking which resources each query returns.",
  "server_timezone": "America/New_York",
  "why_hard": "Without a prefix, a quantity search matches the implicit range of the number as written ('100' is [99.5, 100.5), '100.0' is [99.95, 100.05)), while gt/lt/ge/le compare exactly. system|code must both match; an empty system matches code or unit text; the server never converts units.",
  "resources": [
    {"resourceType": "Observation", "id": "w-01", "status": "final", "code": {"coding": [{"system": "http://loinc.org", "code": "29463-7", "display": "Body weight"}]}, "effectiveDateTime": "2024-02-01T09:00:00-05:00", "valueQuantity": {"value": 100, "unit": "kg", "system": "http://unitsofmeasure.org", "code": "kg"}},
    {"resourceType": "Observation", "id": "w-02", "status": "final", "code": {"coding": [{"system": "http://loinc.org", "code": "29463-7"}]}, "effectiveDateTime": "2024-02-02T09:00:00-05:00", "valueQuantity": {"value": 100.4, "unit": "kg", "system": "http://unitsofmeasure.org", "code": "kg"}},
    {"resourceType": "Observation", "id": "w-03", "status": "final", "code": {"coding": [{"system": "http://loinc.org", "code": "29463-7"}]}, "effectiveDateTime": "2024-02-03T09:00:00-05:00", "valueQuantity": {"value": 100.5, "unit": "kg", "system": "http://unitsofmeasure.org", "code": "kg"}},
    {"resourceType": "Observation", "id": "w-04", "status": "final", "code": {"coding": [{"system": "http://loinc.org", "code": "29463-7"}]}, "effectiveDateTime": "2024-02-04T09:00:00-05:00", "valueQuantity": {"value": 99.5, "unit": "kg", "system": "http://unitsofmeasure.org", "code": "kg"}},
    {"resourceType": "Observation", "id": "w-05", "status": "final", "code": {"coding": [{"system": "http://loinc.org", "code": "29463-7"}]}, "effectiveDateTime": "2024-02-05T09:00:00-05:00", "valueQuantity": {"value": 220.5, "unit": "lb", "system": "http://unitsofmeasure.org", "code": "[lb_av]"}},
    {"resourceType": "Observation", "id": "w-06", "status": "final", "code": {"coding": [{"system": "http://loinc.org", "code": "29463-7"}]}, "effectiveDateTime": "2024-02-06T09:00:00-05:00", "valueQuantity": {"value": 100.04, "unit": "kg", "system": "http://unitsofmeasure.org", "code": "kg"}},
    {"resourceType": "Observation", "id": "w-07", "status": "final", "code": {"coding": [{"system": "http://loinc.org", "code": "29463-7"}]}, "effectiveDateTime": "2024-02-07T09:00:00-05:00", "valueQuantity": {"value": 99.94, "unit": "kg", "system": "http://unitsofmeasure.org", "code": "kg"}},
    {"resourceType": "Observation", "id": "w-08", "status": "final", "code": {"coding": [{"system": "http://loinc.org", "code": "29463-7"}]}, "effectiveDateTime": "2024-02-08T09:00:00-05:00", "valueQuantity": {"value": 100, "unit": "kg"}},
    {"resourceType": "Observation", "id": "w-09", "status": "final", "code": {"coding": [{"system": "http://loinc.org", "code": "29463-7"}]}, "effectiveDateTime": "2024-02-09T09:00:00-05:00", "valueQuantity": {"value": 100.0, "unit": "kilograms", "system": "http://unitsofmeasure.org", "code": "kg"}},
    {"resourceType": "Observation", "id": "w-10", "status": "final", "code": {"coding": [{"system": "http://loinc.org", "code": "29463-7"}]}, "effectiveDateTime": "2024-02-10T09:00:00-05:00", "valueString": "patient refused"}
  ],
  "queries": [
    {"id": "q1", "query": "Observation?value-quantity=100|http://unitsofmeasure.org|kg",
     "expected": ["Observation/w-01", "Observation/w-02", "Observation/w-04", "Observation/w-06", "Observation/w-07", "Observation/w-09"],
     "rationale": "[99.5, 100.5) with UCUM kg. 03 (100.5) is the excluded upper bound; 04 (99.5) the included lower bound. 08 has no system; 05 is pounds (220.5 lb ~ 100 kg, but no conversion)."},
    {"id": "q2", "query": "Observation?value-quantity=100.0|http://unitsofmeasure.org|kg",
     "expected": ["Observation/w-01", "Observation/w-06", "Observation/w-09"],
     "rationale": "[99.95, 100.05): 100.04 in, 99.94 out."},
    {"id": "q3", "query": "Observation?value-quantity=100||kg",
     "expected": ["Observation/w-01", "Observation/w-02", "Observation/w-04", "Observation/w-06", "Observation/w-07", "Observation/w-08", "Observation/w-09"],
     "rationale": "Empty system: matches Quantity.code or Quantity.unit equal to 'kg', so w-08 (unit only) and w-09 (code kg, unit 'kilograms') both qualify."},
    {"id": "q4", "query": "Observation?value-quantity=gt100|http://unitsofmeasure.org|kg",
     "expected": ["Observation/w-02", "Observation/w-03", "Observation/w-06"],
     "rationale": "Exact comparison: 100.04 > 100; 100 and 100.0 are not."},
    {"id": "q5", "query": "Observation?value-quantity=ne100|http://unitsofmeasure.org|kg",
     "expected": ["Observation/w-03"],
     "rationale": "Unit must still match; among UCUM-kg values only 100.5 is outside [99.5, 100.5)."},
    {"id": "q6", "query": "Observation?value-quantity=lt100.0||kg",
     "expected": ["Observation/w-04", "Observation/w-07"],
     "rationale": "Exact < 100 among kg values: 99.5 and 99.94."}
  ],
  "traps": {
    "Observation/w-02": ["quantity-precision-range"],
    "Observation/w-03": ["quantity-precision-range"],
    "Observation/w-04": ["quantity-precision-range"],
    "Observation/w-05": ["unit-no-conversion"],
    "Observation/w-06": ["quantity-precision-range", "exact-comparison-boundary"],
    "Observation/w-07": ["quantity-precision-range"],
    "Observation/w-08": ["quantity-unit-matching"],
    "Observation/w-09": ["quantity-unit-matching"],
    "Observation/w-10": ["missing-value"]
  }
}
