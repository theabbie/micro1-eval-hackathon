 "queries": [
  {
   "id": "q1",
   "query": "Patient?name=munoz",
   "expected": [
    "Patient/p-01",
    "Patient/p-07"
   ],
   "rationale": "Accent-insensitive: Muñoz (01) and old name Munoz (07). Old names are still HumanNames."
  },
  {
   "id": "q2",
   "query": "Patient?family=quinones",
   "expected": [
    "Patient/p-02"
   ],
   "rationale": "Family parts searched independently: 'Quiñones' in 'Carreño Quiñones'."
  },
  {
   "id": "q3",
   "query": "Patient?given=eve",
   "expected": [
    "Patient/p-03",
    "Patient/p-04",
    "Patient/p-09",
    "Patient/p-10"
   ],
   "rationale": "Starts with, case-insensitive: Eve, Evelyn, EVE, Eve. Family 'Eve' (08) is not a given name; Séverine does not start with eve."
  },
  {
   "id": "q4",
   "query": "Patient?given:contains=eve",
   "expected": [
    "Patient/p-03",
    "Patient/p-04",
    "Patient/p-05",
    "Patient/p-06",
    "Patient/p-09",
    "Patient/p-10"
   ],
   "rationale": "Anywhere, case/accent-insensitive: adds Séverine and Steve."
  },
  {
   "id": "q5",
   "query": "Patient?given:exact=Eve",
   "expected": [
    "Patient/p-03",
    "Patient/p-10"
   ],
   "rationale": "Exact, case-sensitive: not EVE (09)."
  },
  {
   "id": "q6",
   "query": "Patient?name=jon",
   "expected": [
    "Patient/p-03",
    "Patient/p-06",
    "Patient/p-08"
   ],
   "rationale": "name covers family (parts), given, prefix, suffix, text: Jones (06), part 'Jones' of Smith-Jones (03), given Jon (08). Johansson does not start with 'jon'."
  },
  {
   "id": "q7",
   "query": "Patient?family:exact=Smith",
   "expected": [
    "Patient/p-10"
   ],
   "rationale": ":exact compares the whole family value, case-sensitively: not SMITH, not Smith-Jones, not Smithers."
  },
  {
   "id": "q8",
   "query": "Patient?identifier=http://hospital.example.org/fhir/sid/mrn|000123",
   "expected": [
    "Patient/p-01"
   ],
   "rationale": "System and value both exact: 02 has value 123; 03 is another system."
  },
  {
   "id": "q9",
   "query": "Patient?identifier=000123",
   "expected": [
    "Patient/p-01",
    "Patient/p-03",
    "Patient/p-06"
   ],
   "rationale": "Bare value: any system, any identifier type (includes 06's driver's licence)."
  },
  {
   "id": "q10",
   "query": "Patient?identifier:of-type=http://terminology.hl7.org/CodeSystem/v2-0203|MR|000123",
   "expected": [
    "Patient/p-01",
    "Patient/p-03"
   ],
   "rationale": "Type MR and value 000123, any system: 01 and 03; 06's 000123 is a DL."
  },
  {
   "id": "q11",
   "query": "Patient?name=dr&gender=male",
   "expected": [
    "Patient/p-06"
   ],
   "rationale": "Prefix 'Dr.' starts with 'dr'."
  }
 ],
